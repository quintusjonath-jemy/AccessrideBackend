# Environment Mode (development / production)
APP_ENV=development

# Application Base URLs
BACKEND_BASE=http://localhost
FRONTEND_BASE=http://localhost:5173

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=accessride

# Security & Encryption Key (AES-256 for passwords and settings)
ENCRYPTION_KEY=AccessRideSecureEncryptionKey2026!

# SMS Gateway Configuration (Supported: textlk, textbelt, twilio)
SMS_GATEWAY=textlk
TEXTLK_API_KEY=your_textlk_api_key_here
TEXTLK_SENDER_ID=TextLKDemo
EMERGENCY_NUMBER=+16592254138

# Twilio SMS Backup Configuration
TWILIO_SID=your_twilio_sid_here
TWILIO_TOKEN=your_twilio_token_here
TWILIO_FROM=+16592254138

# PayHere Payment Gateway (Driver Subscription Payments)
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_SECRET=your_payhere_merchant_secret
PAYHERE_SANDBOX=true

# OpenAI API Key (Voice Assistant & TTS Proxy)
OPENAI_API_KEY=your_openai_api_key_here

# Mapbox Geocoding (Backend ride distance & route calculations)
MAPBOX_TOKEN=your_mapbox_token_here
MAPBOX_API_URL=https://api.mapbox.com

# SSL Peer Verification for cURL (Set to true in production)
CURL_SSL_VERIFY=true
